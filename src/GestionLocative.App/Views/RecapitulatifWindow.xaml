<Window x:Class="GestionLocative.App.Views.RecapitulatifWindow"
        Icon="/Assets/Icone.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:recap="clr-namespace:GestionLocative.Core.Recapitulatif;assembly=GestionLocative.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=recap:RecapitulatifViewModel}"
        Title="{Binding Titre}"
        Width="980" Height="680" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource FondFenetre}"
        Foreground="{DynamicResource Texte}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Colonnes communes à l'en-tête, aux lignes et au total (la dernière marge laisse la place à la barre de défilement) -->
        <Style x:Key="Cellule" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="CelluleNombre" TargetType="TextBlock" BasedOn="{StaticResource Cellule}">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="PageUp" Command="{Binding AnneePrecedenteCommand}" />
        <KeyBinding Key="PageDown" Command="{Binding AnneeSuivanteCommand}" />
    </Window.InputBindings>

    <DockPanel Margin="24">
        <!-- En-tête : titre et choix de l'année -->
        <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource BoutonNavigation}" Content="&#xE76B;"
                        ToolTip="Année précédente (Page préc.)" AutomationProperties.Name="Année précédente"
                        Command="{Binding AnneePrecedenteCommand}" />
                <TextBlock Text="{Binding Annee}" FontSize="18" FontWeight="SemiBold" Margin="14,0,10,0"
                           VerticalAlignment="Center" />
                <Button Style="{StaticResource BoutonNavigation}" Content="&#xE76C;"
                        ToolTip="Année suivante (Page suiv.)" AutomationProperties.Name="Année suivante"
                        Command="{Binding AnneeSuivanteCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding Titre}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Resume}" FontSize="13" Margin="0,4,0,0" Foreground="{DynamicResource TexteSecondaire}" />
            </StackPanel>
        </DockPanel>

        <!-- Boutons du bas -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,18,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" MaxWidth="360"
                       Foreground="{DynamicResource TexteSecondaire}"
                       Text="Double-cliquez sur une location pour la modifier. Une location à cheval sur deux années compte dans l'année de son arrivée." />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource Bouton}" Content="Liste des présences…"
                        ToolTip="Séjours d'un client, avec les nuitées et le nombre de personnes par nuit"
                        Click="Presences_Click" />
                <Button Style="{StaticResource Bouton}" Content="Imprimer / PDF…"
                        ToolTip="Imprimer le tableau, ou l'enregistrer en PDF avec l'imprimante « Microsoft Print to PDF »"
                        Click="Imprimer_Click" />
                <Button Style="{StaticResource BoutonPrincipal}" Content="Fermer" IsCancel="True" IsDefault="True" />
            </StackPanel>
        </DockPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource BlocErreurs}" Margin="0,12,0,0">
            <TextBlock Text="{Binding Erreurs}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Erreur}" />
        </Border>

        <!-- Tableau -->
        <Border Margin="0,16,0,0" CornerRadius="8" BorderThickness="1" ClipToBounds="True"
                Background="{DynamicResource FondVignette}" BorderBrush="{DynamicResource Bordure}">
            <DockPanel>
                <!-- En-tête des colonnes -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource FondVignetteHorsMois}" CornerRadius="8,8,0,0"
                        BorderBrush="{DynamicResource Bordure}" BorderThickness="0,0,0,1" Padding="0,9,10,9"
                        TextElement.FontWeight="SemiBold">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" /><ColumnDefinition Width="70" /><ColumnDefinition Width="130" /><ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource Cellule}" Foreground="{DynamicResource TexteSecondaire}" Text="Arrivée" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Cellule}" Foreground="{DynamicResource TexteSecondaire}" Text="Départ" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Cellule}" Foreground="{DynamicResource TexteSecondaire}" Text="Client" />
                        <TextBlock Grid.Column="3" Style="{StaticResource CelluleNombre}" Foreground="{DynamicResource TexteSecondaire}" Text="Nuits" />
                        <TextBlock Grid.Column="4" Style="{StaticResource CelluleNombre}" Foreground="{DynamicResource TexteSecondaire}" Text="Pers." />
                        <TextBlock Grid.Column="5" Style="{StaticResource CelluleNombre}" Foreground="{DynamicResource TexteSecondaire}" Text="Total HT" />
                        <TextBlock Grid.Column="6" Style="{StaticResource CelluleNombre}" Foreground="{DynamicResource TexteSecondaire}" Text="Total TTC" />
                    </Grid>
                </Border>

                <!-- Totaux, toujours visibles en bas du tableau -->
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource AccentClair}" CornerRadius="0,0,8,8"
                        BorderBrush="{DynamicResource Accent}" BorderThickness="0,2,0,0" Padding="0,11,10,11"
                        TextElement.FontWeight="Bold">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" /><ColumnDefinition Width="70" /><ColumnDefinition Width="130" /><ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource Cellule}" FontSize="14" Text="Total de l'année" />
                        <TextBlock Grid.Column="3" Style="{StaticResource CelluleNombre}" Text="{Binding TotalNuits}" />
                        <TextBlock Grid.Column="5" Style="{StaticResource CelluleNombre}" FontSize="14" Text="{Binding TotalHtAffiche}" />
                        <TextBlock Grid.Column="6" Style="{StaticResource CelluleNombre}" FontSize="14" Text="{Binding TotalTtcAffiche}" />
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Lignes}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type recap:LigneRecapitulatif}">
                                <Border x:Name="Ligne" Padding="0,8" Background="Transparent" Cursor="Hand"
                                        BorderBrush="{DynamicResource Bordure}" BorderThickness="0,0,0,1"
                                        ToolTip="{Binding DetailPersonnes}"
                                        MouseLeftButtonDown="Ligne_MouseLeftButtonDown">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" /><ColumnDefinition Width="70" /><ColumnDefinition Width="130" /><ColumnDefinition Width="130" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource Cellule}" Text="{Binding Arrivee}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource Cellule}" Text="{Binding Depart}" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource Cellule}">
                                            <Run Text="{Binding Client, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="{Binding Origine, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource Accent}" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="3" Style="{StaticResource CelluleNombre}" Text="{Binding Nuits}" />
                                        <TextBlock Grid.Column="4" Style="{StaticResource CelluleNombre}" Text="{Binding Personnes}" />
                                        <TextBlock Grid.Column="5" Style="{StaticResource CelluleNombre}" Foreground="{DynamicResource TexteSecondaire}" Text="{Binding HtAffiche}" />
                                        <TextBlock Grid.Column="6" Style="{StaticResource CelluleNombre}" Text="{Binding TtcAffiche}" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Ligne" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Ligne" Property="Background" Value="{DynamicResource Survol}" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
