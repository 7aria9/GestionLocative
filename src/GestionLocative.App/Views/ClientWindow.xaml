<Window x:Class="GestionLocative.App.Views.ClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GestionLocative.Core.ViewModels;assembly=GestionLocative.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ClientEditionViewModel}"
        Title="Nouveau client"
        Width="560" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource FondFenetre}"
        FontFamily="Segoe UI"
        FocusManager.FocusedElement="{Binding ElementName=ChampNom}">

    <StackPanel Margin="24">
        <TextBlock Text="Nouveau client" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Texte}" />
        <TextBlock Text="Les champs marqués * sont obligatoires. L'email ne peut pas être utilisé par deux clients."
                   TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TexteSecondaire}" Margin="0,4,0,0" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0">
                <TextBlock Style="{StaticResource Libelle}" Text="Nom *" />
                <TextBox x:Name="ChampNom" Style="{StaticResource Champ}" AutomationProperties.Name="Nom"
                         Text="{Binding Nom, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2">
                <TextBlock Style="{StaticResource Libelle}" Text="Prénom *" />
                <TextBox Style="{StaticResource Champ}" AutomationProperties.Name="Prénom"
                         Text="{Binding Prenom, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0">
                <TextBlock Style="{StaticResource Libelle}" Text="Téléphone *" />
                <TextBox Style="{StaticResource Champ}" AutomationProperties.Name="Téléphone"
                         Text="{Binding Telephone, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2">
                <TextBlock Style="{StaticResource Libelle}" Text="Email *" />
                <TextBox Style="{StaticResource Champ}" AutomationProperties.Name="Email"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                <TextBlock Style="{StaticResource Libelle}" Text="Adresse" />
                <TextBox Style="{StaticResource Champ}" AutomationProperties.Name="Adresse"
                         Text="{Binding Adresse, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource Libelle}" Text="Code postal" />
                    <TextBox Style="{StaticResource Champ}" AutomationProperties.Name="Code postal"
                             Text="{Binding CodePostal, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource Libelle}" Text="Ville" />
                    <TextBox Style="{StaticResource Champ}" AutomationProperties.Name="Ville"
                             Text="{Binding Ville, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="4" Grid.Column="0">
                <TextBlock Style="{StaticResource Libelle}" Text="Plaque d'immatriculation" />
                <TextBox Style="{StaticResource Champ}" AutomationProperties.Name="Plaque d'immatriculation"
                         CharacterCasing="Upper"
                         Text="{Binding PlaqueImmatriculation, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource BlocErreurs}">
            <TextBlock Text="{Binding Erreurs}" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource Erreur}" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Style="{StaticResource Bouton}" Content="Annuler" IsCancel="True" />
            <Button Style="{StaticResource BoutonPrincipal}" Content="Enregistrer le client" IsDefault="True"
                    Command="{Binding EnregistrerCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
