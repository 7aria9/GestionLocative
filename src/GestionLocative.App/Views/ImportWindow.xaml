<Window x:Class="GestionLocative.App.Views.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:imp="clr-namespace:GestionLocative.Core.Import;assembly=GestionLocative.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=imp:ImportViewModel}"
        Title="Importer des clients ou des locations (CSV)"
        Width="1040" Height="720" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource FondFenetre}"
        Foreground="{DynamicResource Texte}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style x:Key="Cellule" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="24">
        <!-- En-tête -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Importer depuis un fichier CSV" FontSize="22" FontWeight="SemiBold" />
            <TextBlock FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TexteSecondaire}"
                       Text="Export de l'ancien programme, d'Excel ou de LibreOffice : séparateur « ; » ou « , », encodage UTF-8 ou Windows-1252. Rien n'est enregistré avant le bouton « Importer »." />
        </StackPanel>

        <!-- Type de fichier -->
        <Grid DockPanel.Dock="Top" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <RadioButton Grid.Column="0" Style="{StaticResource CarteChoix}" GroupName="TypeImport"
                         AutomationProperties.Name="Fichier de clients" IsChecked="{Binding ImportClients}">
                <StackPanel Margin="4,0">
                    <TextBlock Text="1. Clients" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Nom, prénom, téléphone, email… Dédoublonnés par email." FontSize="12"
                               Foreground="{DynamicResource TexteSecondaire}" TextWrapping="Wrap" />
                </StackPanel>
            </RadioButton>
            <RadioButton Grid.Column="2" Style="{StaticResource CarteChoix}" GroupName="TypeImport"
                         AutomationProperties.Name="Fichier de locations" IsChecked="{Binding ImportLocations}">
                <StackPanel Margin="4,0">
                    <TextBlock Text="2. Locations" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Dates, tarif TTC, voyageurs… Rattachées au client par son ancien n° ou son email." FontSize="12"
                               Foreground="{DynamicResource TexteSecondaire}" TextWrapping="Wrap" />
                </StackPanel>
            </RadioButton>
        </Grid>

        <TextBlock DockPanel.Dock="Top" Text="{Binding Consigne}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TexteSecondaire}" />

        <!-- Fichier -->
        <DockPanel DockPanel.Dock="Top" Margin="0,14,0,0">
            <Button DockPanel.Dock="Left" Style="{StaticResource Bouton}" Content="Choisir un fichier…" Margin="0,0,12,0"
                    ToolTip="Fichier .csv ou .txt (dans Excel : Fichier › Enregistrer sous › CSV (séparateur : point-virgule))"
                    Click="ChoisirFichier_Click" />
            <TextBlock Text="{Binding CheminFichier, TargetNullValue='Aucun fichier choisi'}" VerticalAlignment="Center"
                       FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding CheminFichier}" />
        </DockPanel>

        <!-- Boutons du bas -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,18,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" MaxWidth="420"
                       Foreground="{DynamicResource TexteSecondaire}"
                       Text="Réimporter le même fichier ne crée pas de doublons. Le format attendu est décrit dans le README (dossier exemples-import)." />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource Bouton}" Content="Copier le rapport"
                        IsEnabled="{Binding AUnRapport}"
                        ToolTip="Copier le détail des lignes rejetées et déjà présentes, pour le corriger dans Excel"
                        Click="CopierRapport_Click" />
                <Button Style="{StaticResource BoutonPrincipal}" Content="Importer"
                        IsEnabled="{Binding PeutImporter}"
                        ToolTip="Enregistrer les lignes « À importer » (les lignes rejetées ou déjà présentes sont ignorées)"
                        Click="Importer_Click" />
                <Button Style="{StaticResource Bouton}" Content="Fermer" IsCancel="True" />
            </StackPanel>
        </DockPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource BlocErreurs}" Margin="0,12,0,0">
            <TextBlock Text="{Binding Erreurs}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Erreur}" />
        </Border>

        <!-- Aperçu -->
        <DockPanel Margin="0,16,0,0" Visibility="{Binding AUnRapport, Converter={StaticResource Visible}}">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="{Binding Resume}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Texte}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PeutImporter}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource Erreur}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Rapport.Enregistre}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Succes}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- Avertissements (colonne n° client absente...) : l'import reste possible -->
                <Border Margin="0,8,0,4" Padding="10,8" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource AccentClair}" BorderBrush="{DynamicResource Accent}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Avertissements}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Avertissements}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Texte}" />
                </Border>
                <TextBlock Text="{Binding DescriptionFichier}" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource TexteSecondaire}" />
                <TextBlock Text="{Binding Colonnes}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TexteSecondaire}" />

                <!-- Filtre -->
                <ListBox ItemsSource="{Binding Filtres}" SelectedItem="{Binding Filtre}" Margin="0,10,0,8"
                         HorizontalAlignment="Left" Padding="2" AutomationProperties.Name="Lignes affichées">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="13" Margin="4,2" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- Lignes -->
            <ListBox ItemsSource="{Binding Lignes}" AutomationProperties.Name="Lignes du fichier"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type imp:LigneRapport}">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource Cellule}" Foreground="{DynamicResource TexteSecondaire}">
                                <Run Text="Ligne" /> <Run Text="{Binding NumeroLigne, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock x:Name="Statut" Grid.Column="1" Style="{StaticResource Cellule}" FontWeight="SemiBold"
                                       Text="{Binding StatutAffiche}" Foreground="{DynamicResource Succes}" />
                            <StackPanel Grid.Column="2" Margin="8,0">
                                <TextBlock Text="{Binding Resume}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="Detail" Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TexteSecondaire}" />
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Statut}" Value="Rejetee">
                                <Setter TargetName="Statut" Property="Foreground" Value="{DynamicResource Erreur}" />
                                <Setter TargetName="Detail" Property="Foreground" Value="{DynamicResource Erreur}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Statut}" Value="DejaPresente">
                                <Setter TargetName="Statut" Property="Foreground" Value="{DynamicResource TexteSecondaire}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Detail}" Value="">
                                <Setter TargetName="Detail" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </DockPanel>
</Window>
