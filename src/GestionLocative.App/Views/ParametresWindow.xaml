<Window x:Class="GestionLocative.App.Views.ParametresWindow"
        Icon="/Assets/Icone.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GestionLocative.Core.ViewModels;assembly=GestionLocative.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ParametresViewModel}"
        Title="Paramètres"
        Width="640" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource FondFenetre}"
        Foreground="{DynamicResource Texte}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Aperçu miniature d'un thème : fenêtre, deux vignettes avec une location, bouton principal -->
        <Style x:Key="ApercuTitre" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,8,0,0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock Text="Apparence" FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource Texte}" Margin="0,0,0,6" />
        <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TexteSecondaire}" Margin="0,0,0,10">
            Le thème s'applique tout de suite pour l'essayer, et il est mémorisé sur ce poste en cliquant sur Enregistrer.
        </TextBlock>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <RadioButton Grid.Column="0" Style="{StaticResource CarteChoix}" GroupName="Theme"
                         AutomationProperties.Name="Thème clair" IsChecked="{Binding ThemeClair}">
                <StackPanel>
                    <Border Height="64" CornerRadius="6" Background="#F6F5FA" BorderBrush="#E2DFEC" BorderThickness="1" Padding="8">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Border Width="54" Height="34" CornerRadius="4" Background="#FFFFFF" BorderBrush="#E2DFEC" BorderThickness="1" Margin="0,0,6,0">
                                    <Border Height="10" Margin="4,0" VerticalAlignment="Bottom" CornerRadius="2" Background="#DBEAFE" BorderBrush="#3B82F6" BorderThickness="2,0,0,0" />
                                </Border>
                                <Border Width="54" Height="34" CornerRadius="4" Background="#FFFFFF" BorderBrush="#E2DFEC" BorderThickness="1">
                                    <Border Height="10" Margin="4,0" VerticalAlignment="Bottom" CornerRadius="2" Background="#DCFCE7" BorderBrush="#22C55E" BorderThickness="2,0,0,0" />
                                </Border>
                            </StackPanel>
                            <Border Width="34" Height="12" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#E5306E" Offset="0" />
                                        <GradientStop Color="#7C4DEB" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock Text="Clair" Style="{StaticResource ApercuTitre}" />
                </StackPanel>
            </RadioButton>
            <RadioButton Grid.Column="2" Style="{StaticResource CarteChoix}" GroupName="Theme"
                         AutomationProperties.Name="Thème sombre" IsChecked="{Binding ThemeSombre}">
                <StackPanel>
                    <Border Height="64" CornerRadius="6" Background="#0E0E13" BorderBrush="#2E2E3B" BorderThickness="1" Padding="8">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Border Width="54" Height="34" CornerRadius="4" Background="#17171F" BorderBrush="#2E2E3B" BorderThickness="1" Margin="0,0,6,0">
                                    <Border Height="10" Margin="4,0" VerticalAlignment="Bottom" CornerRadius="2" Background="#1C2B4A" BorderBrush="#60A5FA" BorderThickness="2,0,0,0" />
                                </Border>
                                <Border Width="54" Height="34" CornerRadius="4" Background="#17171F" BorderBrush="#2E2E3B" BorderThickness="1">
                                    <Border Height="10" Margin="4,0" VerticalAlignment="Bottom" CornerRadius="2" Background="#163A2A" BorderBrush="#4ADE80" BorderThickness="2,0,0,0" />
                                </Border>
                            </StackPanel>
                            <Border Width="34" Height="12" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF3D7F" Offset="0" />
                                        <GradientStop Color="#8B5CF6" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock Text="Sombre" Style="{StaticResource ApercuTitre}" />
                </StackPanel>
            </RadioButton>
        </Grid>

        <TextBlock Text="Base de données" FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource Texte}" Margin="0,22,0,6" />
        <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TexteSecondaire}" Margin="0,0,0,14">
            Emplacement du fichier qui contient les clients et les locations. Pour partager les données entre
            plusieurs ordinateurs du réseau local, placez-le dans un dossier partagé, par exemple
            <Run FontFamily="Consolas">\\SERVEUR\Partage\gestionlocative.db</Run>,
            et indiquez le même chemin sur chaque poste. Si le fichier n'existe pas encore, il est créé.
        </TextBlock>

        <DockPanel LastChildFill="True">
            <Button DockPanel.Dock="Right" Style="{StaticResource Bouton}"
                    Content="Parcourir…" Click="Parcourir_Click" />
            <TextBox x:Name="Chemin"
                     Text="{Binding CheminBase, UpdateSourceTrigger=PropertyChanged}"
                     Height="34" VerticalContentAlignment="Center" Padding="6,0"
                     FontSize="13" AutomationProperties.Name="Chemin de la base de données" />
        </DockPanel>

        <TextBlock x:Name="Message" Text="{Binding Message}" TextWrapping="Wrap"
                   FontSize="13" Margin="0,10,0,0" Foreground="{DynamicResource Succes}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Message}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <TextBlock Text="TVA" FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource Texte}" Margin="0,22,0,6" />
        <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TexteSecondaire}" Margin="0,0,0,10">
            Taux utilisé pour calculer le prix HT à partir du tarif TTC des locations. Il est enregistré dans la base
            de données, donc commun à tous les postes.
        </TextBlock>
        <StackPanel Orientation="Horizontal">
            <TextBox Width="90" Height="34" VerticalContentAlignment="Center" Padding="6,0" FontSize="13"
                     AutomationProperties.Name="Taux de TVA en pourcentage"
                     Text="{Binding TauxTva, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="%" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource Texte}" />
        </StackPanel>

        <TextBlock Text="Prestataire" FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource Texte}" Margin="0,22,0,6" />
        <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TexteSecondaire}" Margin="0,0,0,10">
            Numéros du prestataire (ménage, linge...), copiables depuis le clic droit sur une location.
            Enregistrés dans la base de données, donc communs à tous les postes.
        </TextBlock>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Téléphone principal" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TexteSecondaire}" Margin="0,0,0,4" />
                <TextBox Height="34" VerticalContentAlignment="Center" Padding="6,0" FontSize="13"
                         AutomationProperties.Name="Téléphone principal du prestataire"
                         Text="{Binding TelephonePrestatairePrincipal, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Téléphone secondaire" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TexteSecondaire}" Margin="0,0,0,4" />
                <TextBox Height="34" VerticalContentAlignment="Center" Padding="6,0" FontSize="13"
                         AutomationProperties.Name="Téléphone secondaire du prestataire"
                         Text="{Binding TelephonePrestataireSecondaire, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>

        <DockPanel Margin="0,22,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Style="{StaticResource Bouton}" Margin="0"
                    Content="Emplacement par défaut" Command="{Binding RemettreParDefautCommand}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource BoutonPrincipal}"
                    Content="Enregistrer" IsDefault="True" Command="{Binding EnregistrerCommand}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource Bouton}"
                    Content="Annuler" IsCancel="True" />
            <Button DockPanel.Dock="Right" Style="{StaticResource Bouton}"
                    Content="Tester" Command="{Binding TesterCommand}" />
        </DockPanel>
    </StackPanel>
</Window>
