<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GestionLocative.App</RootNamespace>
    <AssemblyName>GestionLocative</AssemblyName>
    <!-- Permet de compiler (sans exécuter) depuis Linux/macOS, par ex. en intégration continue. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GestionLocative.Core\GestionLocative.Core.csproj" />
  </ItemGroup>

</Project>
