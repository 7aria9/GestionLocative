<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GestionLocative.App</RootNamespace>
    <AssemblyName>GestionLocative</AssemblyName>
    <!-- Permet de compiler (sans exécuter) depuis Linux/macOS, par ex. en intégration continue. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Icône de l'exe (explorateur, barre des tâches). Source : Assets/Icone.svg -->
    <ApplicationIcon>Assets\Icone.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icône des fenêtres (Window.Icon="/Assets/Icone.ico") -->
    <Resource Include="Assets\Icone.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GestionLocative.Core\GestionLocative.Core.csproj" />
  </ItemGroup>

</Project>
