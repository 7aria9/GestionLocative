<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Thème sombre : fond nuit, accents rose néon → violet (repris de Scan-Online). -->
    <Color x:Key="AccentCouleur">#FF3D7F</Color>
    <Color x:Key="Accent2Couleur">#8B5CF6</Color>

    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentCouleur}" />
    <SolidColorBrush x:Key="Accent2" Color="{StaticResource Accent2Couleur}" />
    <SolidColorBrush x:Key="FondFenetre" Color="#0E0E13" />
    <SolidColorBrush x:Key="FondVignette" Color="#17171F" />
    <SolidColorBrush x:Key="FondVignetteWeekEnd" Color="#1C1B27" />
    <SolidColorBrush x:Key="FondVignetteHorsMois" Color="#121218" />
    <SolidColorBrush x:Key="FondChamp" Color="#22222D" />
    <SolidColorBrush x:Key="FondMenu" Color="#17171F" />
    <SolidColorBrush x:Key="Survol" Color="#2A2A37" />
    <SolidColorBrush x:Key="AccentClair" Color="#3A1230" />
    <SolidColorBrush x:Key="Bordure" Color="#2E2E3B" />
    <SolidColorBrush x:Key="Texte" Color="#F1F1F6" />
    <SolidColorBrush x:Key="TexteSecondaire" Color="#9C9CB2" />
    <SolidColorBrush x:Key="TexteHorsMois" Color="#55556A" />
    <SolidColorBrush x:Key="TexteSurAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Erreur" Color="#F87171" />
    <SolidColorBrush x:Key="FondErreur" Color="#2A1418" />
    <SolidColorBrush x:Key="Succes" Color="#4ADE80" />
    <SolidColorBrush x:Key="BarreDefilement" Color="#3A3A4A" />

    <!-- Dégradé rose → violet : bouton principal, jour courant -->
    <LinearGradientBrush x:Key="AccentDegrade" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AccentCouleur}" Offset="0" />
        <GradientStop Color="{StaticResource Accent2Couleur}" Offset="1" />
    </LinearGradientBrush>

    <!-- Bandeau du haut de la fenêtre principale -->
    <LinearGradientBrush x:Key="EnTeteDegrade" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#3A1230" Offset="0" />
        <GradientStop Color="#1E1440" Offset="0.55" />
        <GradientStop Color="#0E0E13" Offset="1" />
    </LinearGradientBrush>

    <!-- Couleurs des locations dans le calendrier (fond, texte, liseré) : une par location, en boucle -->
    <SolidColorBrush x:Key="LocationFond0" Color="#1C2B4A" />
    <SolidColorBrush x:Key="LocationTexte0" Color="#BFDBFE" />
    <SolidColorBrush x:Key="LocationLisere0" Color="#60A5FA" />
    <SolidColorBrush x:Key="LocationFond1" Color="#163A2A" />
    <SolidColorBrush x:Key="LocationTexte1" Color="#BBF7D0" />
    <SolidColorBrush x:Key="LocationLisere1" Color="#4ADE80" />
    <SolidColorBrush x:Key="LocationFond2" Color="#3D2F12" />
    <SolidColorBrush x:Key="LocationTexte2" Color="#FDE68A" />
    <SolidColorBrush x:Key="LocationLisere2" Color="#FBBF24" />
    <SolidColorBrush x:Key="LocationFond3" Color="#431B33" />
    <SolidColorBrush x:Key="LocationTexte3" Color="#FBCFE8" />
    <SolidColorBrush x:Key="LocationLisere3" Color="#F472B6" />
    <SolidColorBrush x:Key="LocationFond4" Color="#2E2150" />
    <SolidColorBrush x:Key="LocationTexte4" Color="#DDD6FE" />
    <SolidColorBrush x:Key="LocationLisere4" Color="#A78BFA" />
    <SolidColorBrush x:Key="LocationFond5" Color="#123A38" />
    <SolidColorBrush x:Key="LocationTexte5" Color="#99F6E4" />
    <SolidColorBrush x:Key="LocationLisere5" Color="#2DD4BF" />
    <SolidColorBrush x:Key="LocationFond6" Color="#42260F" />
    <SolidColorBrush x:Key="LocationTexte6" Color="#FED7AA" />
    <SolidColorBrush x:Key="LocationLisere6" Color="#FB923C" />
    <SolidColorBrush x:Key="LocationFond7" Color="#451C1E" />
    <SolidColorBrush x:Key="LocationTexte7" Color="#FECACA" />
    <SolidColorBrush x:Key="LocationLisere7" Color="#F87171" />
    <SolidColorBrush x:Key="LocationFond8" Color="#2A3812" />
    <SolidColorBrush x:Key="LocationTexte8" Color="#D9F99D" />
    <SolidColorBrush x:Key="LocationLisere8" Color="#A3E635" />
    <SolidColorBrush x:Key="LocationFond9" Color="#0F3542" />
    <SolidColorBrush x:Key="LocationTexte9" Color="#A5F3FC" />
    <SolidColorBrush x:Key="LocationLisere9" Color="#22D3EE" />

</ResourceDictionary>
