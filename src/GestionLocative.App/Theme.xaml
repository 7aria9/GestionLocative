<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Couleurs -->
    <SolidColorBrush x:Key="FondFenetre" Color="#F3F4F6" />
    <SolidColorBrush x:Key="FondVignette" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FondVignetteWeekEnd" Color="#F8FAFC" />
    <SolidColorBrush x:Key="FondVignetteHorsMois" Color="#ECEEF1" />
    <SolidColorBrush x:Key="Bordure" Color="#E2E5EA" />
    <SolidColorBrush x:Key="Texte" Color="#1F2937" />
    <SolidColorBrush x:Key="TexteSecondaire" Color="#6B7280" />
    <SolidColorBrush x:Key="TexteHorsMois" Color="#A0A6B0" />
    <SolidColorBrush x:Key="Accent" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentClair" Color="#DBEAFE" />
    <SolidColorBrush x:Key="Survol" Color="#E5E7EB" />

    <!-- Bouton de navigation (mois précédent / suivant) -->
    <Style x:Key="BoutonNavigation" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Texte}" />
        <Setter Property="Background" Value="{StaticResource FondVignette}" />
        <Setter Property="BorderBrush" Value="{StaticResource Bordure}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fond"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{StaticResource Survol}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{StaticResource AccentClair}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bouton texte des fenêtres de dialogue -->
    <Style x:Key="Bouton" TargetType="Button">
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Texte}" />
        <Setter Property="Background" Value="{StaticResource FondVignette}" />
        <Setter Property="BorderBrush" Value="{StaticResource Bordure}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fond"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{StaticResource Survol}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bouton principal (Enregistrer) -->
    <Style x:Key="BoutonPrincipal" TargetType="Button" BasedOn="{StaticResource Bouton}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>

    <SolidColorBrush x:Key="Erreur" Color="#B91C1C" />
    <SolidColorBrush x:Key="FondErreur" Color="#FEF2F2" />

    <!-- Libellé au-dessus d'un champ de saisie -->
    <Style x:Key="Libelle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TexteSecondaire}" />
        <Setter Property="Margin" Value="0,10,0,4" />
    </Style>

    <!-- Titre de section dans une fenêtre de saisie -->
    <Style x:Key="TitreSection" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Texte}" />
        <Setter Property="Margin" Value="0,18,0,0" />
    </Style>

    <!-- Champ de saisie -->
    <Style x:Key="Champ" TargetType="TextBox">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Bloc d'erreurs de saisie, masqué s'il n'y a rien à afficher -->
    <Style x:Key="BlocErreurs" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource FondErreur}" />
        <Setter Property="BorderBrush" Value="{StaticResource Erreur}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,16,0,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Erreurs}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <SolidColorBrush x:Key="Succes" Color="#15803D" />

    <!-- Couleurs des locations dans le calendrier (fond, texte, liseré) : une par location, en boucle -->
    <SolidColorBrush x:Key="LocationFond0" Color="#DBEAFE" />
    <SolidColorBrush x:Key="LocationTexte0" Color="#1E3A8A" />
    <SolidColorBrush x:Key="LocationLisere0" Color="#3B82F6" />
    <SolidColorBrush x:Key="LocationFond1" Color="#DCFCE7" />
    <SolidColorBrush x:Key="LocationTexte1" Color="#14532D" />
    <SolidColorBrush x:Key="LocationLisere1" Color="#22C55E" />
    <SolidColorBrush x:Key="LocationFond2" Color="#FEF3C7" />
    <SolidColorBrush x:Key="LocationTexte2" Color="#78350F" />
    <SolidColorBrush x:Key="LocationLisere2" Color="#F59E0B" />
    <SolidColorBrush x:Key="LocationFond3" Color="#FCE7F3" />
    <SolidColorBrush x:Key="LocationTexte3" Color="#831843" />
    <SolidColorBrush x:Key="LocationLisere3" Color="#EC4899" />
    <SolidColorBrush x:Key="LocationFond4" Color="#EDE9FE" />
    <SolidColorBrush x:Key="LocationTexte4" Color="#4C1D95" />
    <SolidColorBrush x:Key="LocationLisere4" Color="#8B5CF6" />
    <SolidColorBrush x:Key="LocationFond5" Color="#CCFBF1" />
    <SolidColorBrush x:Key="LocationTexte5" Color="#134E4A" />
    <SolidColorBrush x:Key="LocationLisere5" Color="#14B8A6" />
    <SolidColorBrush x:Key="LocationFond6" Color="#FFEDD5" />
    <SolidColorBrush x:Key="LocationTexte6" Color="#7C2D12" />
    <SolidColorBrush x:Key="LocationLisere6" Color="#F97316" />
    <SolidColorBrush x:Key="LocationFond7" Color="#FEE2E2" />
    <SolidColorBrush x:Key="LocationTexte7" Color="#7F1D1D" />
    <SolidColorBrush x:Key="LocationLisere7" Color="#EF4444" />
    <SolidColorBrush x:Key="LocationFond8" Color="#ECFCCB" />
    <SolidColorBrush x:Key="LocationTexte8" Color="#365314" />
    <SolidColorBrush x:Key="LocationLisere8" Color="#84CC16" />
    <SolidColorBrush x:Key="LocationFond9" Color="#CFFAFE" />
    <SolidColorBrush x:Key="LocationTexte9" Color="#164E63" />
    <SolidColorBrush x:Key="LocationLisere9" Color="#06B6D4" />

</ResourceDictionary>
